# Copy to .env.local and fill in. Never commit .env.local.

# Privy (https://dashboard.privy.io): sign-in and wallets
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Gemini (https://aistudio.google.com/apikey): reads descriptions in Send and the Merchant Portal
GEMINI_API_KEY=
# GEMINI_MODEL=

# Optional: a funded Monad testnet wallet's private key, used only to cover the first network fee of
# people who sign in with email. Leave empty to point them to the faucet instead.
# GAS_SPONSOR_KEY=

# Required: Weep's contracts (these are the live ones on Monad testnet; deploy-all.js prints new ones)
NEXT_PUBLIC_WEEP_PAY=0x9F24A86a2d35CC9c281Ee87F6A6204aE782BF5F5
NEXT_PUBLIC_WEEP_POOLS=0xea18adEb9bc624d068eb5ec51fAd66a8FB744996

# Optional: WeepPolicyRegistry, where Weep's Chainlink CRE workflow records team policies (defaults to the live
# one; deploy-policy-registry.js prints a new one). Set it empty to hide the "Read by Chainlink CRE" line.
# NEXT_PUBLIC_WEEP_POLICY_REGISTRY=0x6437a6BD79d388E70f726Fee9f15f3d0245ddc9c

# Optional overrides
# NEXT_PUBLIC_AUSD=0xcEF38D455529Dbc2e37654452C288C25e18ADea4
# NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz
